# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where Personal Drive OS is hosted (used for OAuth callbacks).
APP_URL="MY_APP_URL"

# Cloud SQL / PostgreSQL Connection Variables (Object Method)
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_SSL="false"
SQL_USER="driveos_app"
SQL_PASSWORD="change_me_app_password"
SQL_DB_NAME="personal_drive_os"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change_me_admin_password"

# Server Security Secret (32+ random characters for AES-256-GCM token encryption)
SESSION_SECRET="replace_with_a_long_random_32_byte_secret_key"

# Microsoft Identity Platform (Azure AD App Registration for OneDrive / Word Online)
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT_ID="common"
